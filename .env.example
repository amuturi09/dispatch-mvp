# ---------------------------------------------------------------------------
# RapidDispatch — environment configuration
# Copy this file to `.env` and fill in values. `.env` is gitignored.
#
#   cp .env.example .env
#
# For a FIRST LOCAL TEST you only need the two vars in section (1). Everything
# else can stay blank — the app starts in "degraded" dev mode and the partner
# portal works end-to-end against a local SQLite database. Telephony/billing
# (Twilio/Retell/Stripe) are only needed for real phone calls and charges.
# ---------------------------------------------------------------------------

# (1) MINIMUM FOR LOCAL TESTING ---------------------------------------------

# Signs contractor login sessions. Any long random string for dev.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=dev-change-me-to-a-long-random-string

# Where data lives. Leave as-is for local SQLite, or point at Supabase.
DATABASE_URL=sqlite:///./dispatch_mvp.db
# Supabase (production) — Project Settings → Database → Connection string (URI):
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres


# (2) ADMIN / OPERATOR -------------------------------------------------------
# Protects the admin + analytics endpoints. If blank, they run UNPROTECTED in
# dev (a warning is logged). Set before exposing the app.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_AUTH_TOKEN=

# development | production. In production the app requires https + all creds.
APP_ENV=development

# Public HTTPS URL of this server (used to build webhook + Stripe return URLs).
# Local: use an ngrok URL, e.g. https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=


# (3) STRIPE (card-on-file + lead billing) — optional for first test ---------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=


# (4) TWILIO (inbound calls + warm transfer) — optional for first test -------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# (5) RETELL (voice agent) — optional for first test -------------------------
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_SIP_DOMAIN=
